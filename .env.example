# Master key for credential encryption (DB passwords, indexer/client API keys).
# Generate once and keep it safe – losing it means re-entering stored credentials:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   or on Unraid:  openssl rand -base64 32
MANIAC_MASTER_KEY=

# Only for the optional PostgreSQL profile
POSTGRES_PASSWORD=

TZ=America/New_York
